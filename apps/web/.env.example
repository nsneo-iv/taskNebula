# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasknebula

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Windows Active Directory (LDAP) sign-in (OPTIONAL)
# Requires AD_LDAP_URL + AD_LDAP_SEARCH_BASE; set AD_ENABLED=false to disable
# explicitly even when both are present. See .env.example at repo root for all knobs.
# AD_ENABLED=true
AD_LDAP_URL=
AD_LDAP_SEARCH_BASE=
# AD_LDAP_BIND_DN=
# AD_LDAP_BIND_PASSWORD=
# AD_LDAP_USER_FILTER=(&(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}})))
# AD_LDAP_REQUIRED_GROUP=
# AD_LDAP_MAIL_ATTRIBUTE=mail
# AD_LDAP_NAME_ATTRIBUTE=displayName
# AD_EMAIL_DOMAIN=
# AD_AUTO_PROVISION=true

# OpenID Connect (OIDC) sign-in (OPTIONAL)
# Generic OIDC provider (Entra ID, Okta, Keycloak, ...). Requires
# OIDC_ISSUER + OIDC_CLIENT_ID + OIDC_CLIENT_SECRET; set OIDC_ENABLED=false
# to disable explicitly even when all are present. See .env.example at repo root.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=SSO

# Optional collaborative issue descriptions
NEXT_PUBLIC_COLLAB_ENABLED=false
# NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:1234

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integrations — GitLab OAuth (OPTIONAL)
# These act as a FALLBACK when Admin → Integrations has no GitLab entry.
# Prefer configuring credentials through the admin dashboard at runtime.
# Create an application at https://gitlab.com/-/user_settings/applications.
# Redirect URI must exactly match GITLAB_REDIRECT_URI below.
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/integrations/gitlab/callback
# Optional override (defaults to "read_api read_repository")
GITLAB_OAUTH_SCOPE=

# AI / LLM (for future use)
OPENAI_API_KEY=

# Integrations — Slack OAuth (OPTIONAL)
# Fallback only — super-admins should configure Slack in Admin → Integrations.
# Create a Slack app at https://api.slack.com/apps, then set the following.
# SLACK_REDIRECT_URI must exactly match the "Redirect URL" registered in Slack.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# Integrations — Jira (Atlassian 3LO) OAuth (OPTIONAL)
# Fallback only — prefer Admin → Integrations. Create an app at
# https://developer.atlassian.com/console/myapps/ and register the redirect URI.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback
